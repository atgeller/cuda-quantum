// func.func @test() -> i1 attributes {"cudaq-entrypoint", "cudaq-kernel"} {
//   %0 = quake.null_wire
//   %true = arith.constant true
//   %4:2 = cc.if(%true) ((%arg1 = %0)) -> (i1, !quake.wire) {
//     %4 = quake.y %arg1 : (!quake.wire) -> !quake.wire
//     %5 = quake.x %4 : (!quake.wire) -> !quake.wire
//     cc.continue %true, %5 : i1, !quake.wire
//   } else {
//     %4 = quake.y %arg1 : (!quake.wire) -> !quake.wire
//     %5 = quake.x %4 : (!quake.wire) -> !quake.wire
//     cc.continue %true, %5 : i1, !quake.wire
//   }
//   quake.sink %4#1 : !quake.wire
//   return %4#0 : i1
// }

func.func @__nvqpp__mlirgen__run_test() -> i1 attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %true = arith.constant true
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2 = quake.null_wire
  %3 = quake.h %2 : (!quake.wire) -> !quake.wire
  %4:3 = cc.if(%true) ((%arg0 = %1, %arg1 = %0, %arg2 = %3)) -> (!quake.wire, !quake.wire, !quake.wire) {
    %6 = quake.x %arg0 : (!quake.wire) -> !quake.wire
    %7 = quake.y %arg1 : (!quake.wire) -> !quake.wire
    %8:2 = quake.x [%7] %arg2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
    cc.continue %6, %8#0, %8#1 : !quake.wire, !quake.wire, !quake.wire
  } else {
    %6 = quake.y %arg1 : (!quake.wire) -> !quake.wire
    %7 = quake.x %arg2 : (!quake.wire) -> !quake.wire
    %8:2 = quake.x [%6] %arg0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
    cc.continue %8#1, %8#0, %7 : !quake.wire, !quake.wire, !quake.wire
  }
  %measOut, %wires = quake.mz %4#2 name "b" : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5 = quake.discriminate %measOut : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %4#0 : !quake.wire
  quake.sink %wires : !quake.wire
  return %5 : i1
}
